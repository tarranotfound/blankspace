# ╔══════════════════════════════════════╗
# ║          KITTY — MONO RED            ║
# ╚══════════════════════════════════════╝


# ──────────────────────────────────────
# WINDOW
# ──────────────────────────────────────

# Jangan ingat ukuran window sebelumnya
remember_window_size no

# Ukuran awal window
initial_window_width  640
initial_window_height 300

# Padding isi terminal
window_padding_width 10

# Tidak ada decoration/titlebar dari Kitty
hide_window_decorations yes

# Jangan tanya saat menutup window
confirm_os_window_close 0

# Tidak ada rounding
decoration {
    rounding = 0
}


# ──────────────────────────────────────
# FONT
# ──────────────────────────────────────

font_family JetBrainsMono Nerd Font
font_size   8.5

bold_font   auto
italic_font auto


# ──────────────────────────────────────
# CURSOR
# ──────────────────────────────────────

# Beam / garis vertikal
cursor_shape beam

# 0 = tidak berkedip
cursor_blink_interval 0

# Cursor merah utama
cursor #FC161A

# Warna karakter yang berada di bawah cursor
cursor_text_color #9E3C3D


# ──────────────────────────────────────
# BACKGROUND
# ──────────────────────────────────────

# Background utama
background #FBEBBA
#background #9E3C3D  dark mode

# 1 = solid
# 0.85 = sedikit transparan
# 0.75 = cukup transparan
background_opacity 1


# ──────────────────────────────────────
# TEXT
# ──────────────────────────────────────

# Text utama
foreground #525350
#foreground #E8DADA dark mode

# Text URL
url_color #FF8587


# ──────────────────────────────────────
# SELECTION
# ──────────────────────────────────────

# Text ketika di-select
selection_foreground #FFF1F1

# Background ketika di-select
selection_background #6F292B


# ══════════════════════════════════════
# MONO RED ANSI PALETTE
# ══════════════════════════════════════

# Normal black
color0 #383131

# Normal red
color1 #FC161A

# Muted dark red
color2 #8F3537

# Muted red
color3 #B44749

# Medium red
color4 #A13D40

# Dark crimson
color5 #92373A

# Soft red
color6 #B85A5C

# Light text
color7 #E8DADA


# ──────────────────────────────────────
# BRIGHT COLORS
# ──────────────────────────────────────

# Bright black
color8 #60494A

# Bright red
color9 #FF3033

# Bright dark-red
color10 #A83E40

# Bright red
color11 #C95254

# Bright medium-red
color12 #B7474A

# Bright crimson
color13 #A54144

# Bright soft-red
color14 #C76668

# Bright white
color15 #FFF1F1


# ══════════════════════════════════════
# TABS
# ══════════════════════════════════════

# Powerline tab bar
tab_bar_style powerline
tab_bar_edge top

# Tab aktif
active_tab_foreground #FFF1F1
active_tab_background #6F292B

# Tab tidak aktif
inactive_tab_foreground #B98586
inactive_tab_background #843335


# ══════════════════════════════════════
# KITTY BEHAVIOR
# ══════════════════════════════════════

# Remote control
allow_remote_control yes

# Audio bell dimatikan
enable_audio_bell no


# ══════════════════════════════════════
# OPTIONAL CONFIG
# ══════════════════════════════════════

# File tambahan kalau masih lo pakai
#include kitty-colors.conf

# Noctalia theme — currently disabled
#include themes/noctalia.conf
